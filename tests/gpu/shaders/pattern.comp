#version 450
#include "bindless.glsl"

// Writes a pattern derived from each texel's coordinates, so tests can verify every texel
layout(push_constant) uniform Indices {
    uint outputImage;
} indices;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(bindlessStorageImages[indices.outputImage]);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    // k / 255 converts exactly to the UNORM value k
    vec4 color = vec4(float(texel.x % 256),
                      float(texel.y % 256),
                      float((texel.x + texel.y) % 256),
                      255.0) / 255.0;
    imageStore(bindlessStorageImages[indices.outputImage], texel, color);
}
