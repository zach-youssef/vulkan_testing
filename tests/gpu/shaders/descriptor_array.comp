#version 450
#include "bindless.glsl"

// Reads buffers through a DescriptorArray, whose buffer holds their count and then their indices.
// For each, writes its first value plus 100 times the count.
layout(push_constant) uniform Indices { uint sources; uint target; } indices;
BINDLESS_BUFFER_ARRAY(, Values, uint, values);

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = values[indices.sources].data[0];
    if (i < count) {
        uint source = values[indices.sources].data[1 + i];
        values[indices.target].data[i] = values[nonuniformEXT(source)].data[0] + 100 * count;
    }
}
