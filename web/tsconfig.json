{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "types": ["@webgpu/types", "node"]
  },
  "include": ["zgal/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"]
}
