;; Every feature of the language, for the golden tests (golden-test.rkt): the generated header and
;; shaders are compared with expected/, and compiled by toolchain-test.rkt

(struct Light
  (direction vec3)
  (intensity float)             ; Packed after the vec3
  (color vec4))

(struct Lights
  (count uint)
  (lights (array Light 4)))

(vertex-format MeshVertex
  (position vec3)
  (normal vec3)
  (uv vec2)
  (material uint))

;; Every kind of binding, stages, push constants and every kind of varying
(graphics-material Surface
  (shaders "shaders/surface.vert" "shaders/surface.frag")
  (vertex-input MeshVertex position uv material)
  (bindings
   (lights (buffer Lights read) #:stages (fragment))
   (transforms (buffer-array mat4 read) #:stages (vertex))
   (albedo texture #:stages (fragment))
   (albedoSampler sampler)
   (mask (storage-image read) #:stages (fragment)))
  (push
   (object uint)
   (tint vec3))
  (varyings
   (uv vec2)
   (screen vec2 noperspective)
   (material uint flat))
  (outputs
   (color vec4)
   (normalOut vec4)))

;; Writes buffers and an image: no buffer block is readonly
(compute-material Accumulate
  (shaders "shaders/accumulate.comp")
  (workgroup 8 8)
  (bindings
   (lights (buffer Lights read))
   (sums (buffer-array float read-write))
   (target (storage-image write))))

;; No bindings or push constants at all
(graphics-material Plain
  (shaders "shaders/plain.vert" "shaders/plain.frag")
  (outputs (color vec4)))

;; Functions and constants: pure ones also compile to C++, and every form of the body language
(define golden 1.618)
(define offsets (array vec2 (vec2 0 1) (vec2 1 0)))

(define (polish [x : vec3] [n : int]) : vec3
  (let* ([(total count) (fold ([total (vec3 0.0)] [count 0])
                              ([i (range 0 n)] [j (range i n)])
                          (values (+ total (* x (float j))) (+ count 1)))]
         [scaled (cond [(< count 2) total]
                       [(< count 10) (* total 0.5)]
                       [else (/ total (float count))])])
    (+ scaled (vec3 (sum ([k (range 0 3)]) (at (at offsets (remainder k 2)) 0))
                    golden
                    (float (bitxor (shl 1 n) 3))))))

;; Uses textures, so it's GLSL only
(define (sampled [t : texture2D] [s : sampler] [uv : vec2]) : vec4
  (+ (sample t s uv) (sample-lod t s uv 0.0) (fetch t s (ivec2 0) 0)
     (vec4 (sample-compare t s uv 0.5)) (vec4 (vec2 (texture-size t 0)) 0.0 0.0)))

;; Takes a storage image, so it's inlined where it's called
(define (loadEdge [image : image2D] [texel : ivec2]) : vec4
  (image-load image (min texel (- (image-size image) 1))))

;; ZGAL bodies, with accesses and stages inferred
(graphics-material Shaded
  (vertex-input MeshVertex position uv material)
  (bindings
   (lights (buffer Lights))
   (albedo texture)
   (albedoSampler sampler))
  (push
   (tint vec3))
  (varyings
   (texCoord vec2)
   (id uint flat))
  (outputs
   (color vec4)
   (glow vec4))
  (vertex
   (let* ([p (vec4 position 1.0)])
     (results #:position (* (mat4 1.0) p) #:texCoord uv #:id material)))
  (fragment
   (let* ([base (sampled albedo albedoSampler texCoord)]
          [light (at lights.lights (int (min id 3)))])
     (results #:color (vec4 (* (polish base.rgb 2) tint light.color.rgb) base.a)
              #:glow (if (and (> light.intensity 0.5) (not frontFacing))
                         (vec4 light.direction 1.0)
                         (vec4 0.0))))))

(compute-material Scatter
  (workgroup 8 8)
  (bindings
   (sums (buffer-array float))
   (target (storage-image))
   (settings (buffer Lights)))
  (compute
   (let* ([texel (ivec2 globalInvocationId.xy)]
          [index (+ (* globalInvocationId.y 8) globalInvocationId.x)])
     (begin
       (unless (= settings.count 0)
         (write! (at sums index) (+ (at sums index) (.r (loadEdge target texel)))))
       (for ([i (range 0 2)])
         (store! target (+ texel (ivec2 i 0)) (vec4 (float i))))
       (when (> index 0)
         (write! (at sums 0) 0.0))))))

;; 8- and 16-bit integers (read widened, written narrowed), workgroup shared memory and barriers
(struct Packed
  (flags uint8)
  (level int16)                 ; Aligned to 2 bytes
  (bytes (array uint8 3))
  (offset int8)
  (wide uint))                  ; Aligned to 4 bytes, after byte padding

(compute-material Reduce
  (workgroup 64)
  (bindings
   (packed (buffer-array Packed))
   (total (buffer uint)))
  (shared
   (partial (array uint 64))
   (marks (array uint8 64)))
  (compute
   (let* ([x localInvocationId.x]
          [p (at packed globalInvocationId.x)])
     (write! (at partial x) (+ p.flags (at p.bytes 2) (uint (+ p.level p.offset)) p.wide))
     (write! (at marks x) (uint8 (bitand x 255)))
     (write! (at packed globalInvocationId.x) (with p #:flags (uint8 1) #:level -3))
     (barrier!)
     (for ([level (range 0 6)])
       (let* ([stride (shr 32 (uint level))])
         (when (< x stride)
           (write! (at partial x) (+ (at partial x) (at partial (+ x stride)))))
         (barrier!)))
     (when (= x 0)
       (write! total (+ (at partial 0) (at marks 0)))))))

;; Every graph item, node and option
(graph Everything
  (parameter enabled bool)
  (parameter count int)
  (parameter size uint)
  (parameter scale float)
  (input meshes meshes)
  (input frameLights (per-frame Lights))
  (input tintNow (per-frame vec3))
  (input logger cpu)
  (input upload cpu)
  (input custom extern)
  (import-image picture #:resting shader-read-only)
  (import-buffer packedInput Packed)
  (import-buffer staging Packed)
  (constant pictureWidth (width picture))
  (constant halfScale (/ scale 2.0))
  (constant doubled (* (uint count) 2))
  (sampler basic)
  (sampler shadowed #:filter nearest #:mipmap nearest #:address clamp-to-border #:border opaque-white
           #:compare less-or-equal #:anisotropy #f #:max-lod 4)
  (uniform lightBuffer Lights frameLights)
  (image colorImage rgba16f (surface 0.5) #:frames per-frame)
  (image depthImage d32 (surface 0.5) #:frames shared)
  (image maskImage r32f (fixed pictureWidth (+ size 1)) #:frames shared)
  (image copy rgba8 (extent-of picture) #:frames shared #:when enabled)
  (buffer sumBuffer float (* size size) #:frames shared)
  (buffer transformBuffer mat4 doubled #:frames per-frame #:when (and enabled (> count 0)))
  (target scene (color colorImage #:clear (0.1 0.2 0.3 1.0) #:load clear #:store store)
                (color copy #:load load)
                (depth depthImage #:clear 0.0 #:store dont-care))
  (target screen (if (not enabled) (surface #:clear (0 0 0 1) #:depth d32) (attachments (color copy))))
  (material surface Surface (lights lightBuffer) (transforms transformBuffer) (albedo picture)
            (albedoSampler basic) (mask maskImage)
            #:push ((object (if enabled (max size 1) 0)) (tint (* tintNow (vec3 halfScale 1 (float pictureWidth)))))
            #:cull none #:front-face clockwise #:blend alpha #:depth-test #t #:depth-write #f
            #:depth-compare greater-or-equal #:topology triangle-list)
  ;; Invocations are computed each frame, so they can use graph images' current sizes
  (material accumulate Accumulate (lights lightBuffer) (sums sumBuffer) (target maskImage)
            #:invocations ((width colorImage) (max (height maskImage) size)))
  (material plain Plain)
  (buffer packedCopy Packed 64 #:frames shared)
  (buffer totalBuffer uint 1 #:frames shared)
  (material reduce Reduce (packed packedCopy) (total totalBuffer) #:invocations (64))
  (draw-meshes drawSurface scene meshes surface #:enabled enabled)
  (dispatch accumulate accumulate #:when (>= count 2))
  (draw drawPlain screen plain (* 3 size))
  (readback readMask maskImage)
  (cpu logFrame logger)
  (cpu fillStaging upload #:reads (packedInput) #:writes (staging))
  (copy copyAll packedInput packedCopy)
  (copy copySome staging packedCopy #:count 32 #:source-offset 1 #:destination-offset (uint count) #:enabled enabled)
  (dispatch reduce reduce)
  (extern customNodes custom #:when enabled))

;; Every event, effect and kind of graph binding: parameters computed once, per-frame inputs from
;; the state, node enables (one of a #:when node), and the rest passed through from C++
(app Explorer
  (parameter level int)
  (parameter gain float)
  (state
   (tint vec3 (vec3 gain))
   (cursor vec2 (vec2 0.0))
   (dragging bool #f)
   (zoom float 1.0)
   (frames uint 0)
   (light Light (Light (vec3 0.0 1.0 0.0) gain (vec4 1.0))))
  (on (key-pressed a 1 f12 keypad-add) (with state #:tint (* state.tint 2.0)))
  (on (key-released space) (print! "frames: " state.frames ", dragging: " state.dragging))
  (on (key-pressed escape) (quit!))
  (on (key-pressed 3) (set-frames-in-flight! 3))
  (on (mouse-pressed left at) (with state #:dragging #t #:cursor at))
  (on (mouse-released right at) (with state #:dragging #f))
  (on (cursor-moved at) (if state.dragging (with state #:cursor at) state))
  (on (scrolled offset) (with state #:zoom (* state.zoom (.x (polish (vec3 offset.y) 1)))))
  (on (frame dt)
    (let* ([next (+ state.frames 1)])
      (when (= (remainder next 100) 0)
        (print! "frame " next " of " framesInFlight " in flight at " surfaceSize.x))
      (with state #:frames next)))
  (run Everything
    (enabled (> level 0))
    (count level)
    (size (uint (* level 2)))
    (scale gain)
    (tintNow (* state.tint state.zoom))
    #:enabled ((accumulate state.dragging)
               (drawPlain (not state.dragging)))))
