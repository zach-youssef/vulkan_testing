#lang racket/base
;; The C++ backend for a program's main: <file>.main.cpp, parsing the command line into the app's
;; inputs and running it (include/zgal/Main.h, Window.h), and in the header, what the program's own
;; C++ gives when main can't (MainInputs).

(require racket/list
         racket/match
         racket/string
         "ast.rkt"
         "cpp-app.rkt"
         "cpp-common.rkt"
         "main.rkt"
         "writer.rkt")

(provide emit-main-inputs!
         emit-main)

(define (lower-first s) (string-append (string-downcase (substring s 0 1)) (substring s 1)))

;; The app's parameters no option sets, which the program's C++ gives
(define (given-parameters m)
  (define a (main-decl-app m))
  (for/list ([p (in-list (app-parameters a))]
             #:unless (for/or ([o (in-list (main-decl-options m))])
                        (or (eq? (main-option-parameter o) p) (equal? (main-option-given o) (field-name p)))))
    p))

;; Whether the program's C++ gives anything
(define (cpp-inputs? m)
  (or (pair? (given-parameters m)) (pair? (app-given-members (main-decl-app m)))))

;; In the header: what the program's C++ gives the app, and the function giving it, which the
;; program's C++ defines
(define (emit-main-inputs! w prog m)
  (when (cpp-inputs? m)
    (define a (main-decl-app m))
    (define (gen text) (emit! w text))
    (gen "")
    (gen (format "// What the program's C++ gives app ~a, which its main (~a.main.cpp) can't: the parameters no"
                 (app-name a) (program-namespace-file prog)))
    (gen "// option sets, the extern functions and the graph inputs the app doesn't compute")
    (emit! w "struct MainInputs {" #:at (main-decl-loc m))
    (for ([p (in-list (given-parameters m))])
      (emit! w (format "    ~a{};" (declaration-cpp (field-type p) (field-name p))) #:at (field-loc p)))
    (for ([g (in-list (app-given-members a))])
      (emit! w (string-append "    " (second g)) #:at (third g)))
    (gen "};")
    (gen "")
    (gen "// Defined by the program's C++, which main calls once the context exists")
    (gen "Result<MainInputs> mainInputs(VulkanContext& context);")))

(define (program-namespace-file prog)
  (let-values ([(_dir name _d) (split-path (program-source prog))]) (path->string name)))

;; A C++ literal of an option's value
(define (value-cpp v type)
  (case type
    [(uint) (format "~au" v)]
    [(int) (format "~a" v)]
    [(float) (let ([t (number->string (exact->inexact v))]) (string-append t (if (regexp-match? #rx"[.e]" t) "f" ".0f")))]
    [(path) (format "zgal::commandLinePath(~a)" (cpp-string v))]))

(define (metavar o)
  (case (main-option-kind o)
    [(positional) (format "<~a>" (field-name (main-option-parameter o)))]
    [else (case (option-value-type (main-option-parameter o))
            [(int uint) "<integer>"] [(float) "<number>"] [(path) "<path>"])]))

;; An option's help, with its range and default
(define (help-text o)
  (define notes
    (filter values
            (list (and (main-option-range o) (format "~a to ~a" (car (main-option-range o)) (cdr (main-option-range o))))
                  (and (main-option-default o) (format "default ~a" (main-option-default o))))))
  (if (null? notes) (main-option-help o) (format "~a (~a)" (main-option-help o) (string-join notes ", "))))

;; The text of the program's main, written to out-path. header: the generated header's file name.
(define (emit-main prog m header out-path)
  (define w (make-writer out-path))
  (define (gen text) (emit! w text))
  (define a (main-decl-app m))
  (define ns (program-namespace prog))
  (define window (main-decl-window m))
  (define capture (main-decl-capture m))
  (define runs (app-runs a))
  (define models? (for*/or ([g (in-list (program-graphs prog))] [item (in-list (graph-items g))]) (g-model? item)))

  (gen (format "// Generated by zgal from ~a. Don't edit it: edit that." (program-source prog)))
  (gen (format "// The program running app ~a: its command line (the built-in options and the app's), then the app~a."
               (app-name a) (if window " in a window or headless" ", headless")))
  (gen "// The wrapper's implementation, stb_image's and stb_image_write's are compiled here.")
  (gen "#define VK_WRAP_UTIL_IMPL")
  (gen "#define STB_IMAGE_IMPLEMENTATION")
  (gen "#define STB_IMAGE_WRITE_IMPLEMENTATION")
  (gen "")
  (gen (format "#include ~s" header))
  (when models?
    (gen "#include \"resources/Model.h\""))
  (gen (if window "#include \"zgal/Window.h\"" "#include \"zgal/Main.h\""))
  (gen "")
  (gen "#include <filesystem>")
  (gen "#include <string>")
  (gen "")
  (emit! w "int main(int argc, char** argv) {" #:at (main-decl-loc m))
  (gen (format "    using App = ~a::~a;" ns (app-name a)))
  (gen "    // What the command line sets: the options' parameters, with their defaults")
  (gen "    App::Inputs inputs;")
  (for ([o (in-list (main-decl-options m))] #:when (main-option-default o))
    (define p (main-option-parameter o))
    (emit! w (format "    inputs.~a = ~a;" (field-name p) (value-cpp (main-option-default o) (option-value-type p)))
           #:at (main-option-loc o)))
  (gen "    zgal::CommandLine commandLine(zgal::MainSpec{")
  (gen "        .program = std::filesystem::path(argv[0]).filename().string(),")
  (when (main-decl-about m)
    (gen (format "        .about = ~a," (cpp-string (main-decl-about m)))))
  (when window
    (match-define (list title width height) window)
    (gen (format "        .window = zgal::MainSpec::Window{~a, ~a, ~a}," (cpp-string title) width height)))
  (when (and capture (not (third capture)))
    (gen "        .captureOption = true,"))
  (unless (null? (main-decl-controls m))
    (gen "        .controls = {")
    (for ([line (in-list (main-decl-controls m))])
      (gen (format "            ~a," (cpp-string line))))
    (gen "        },"))
  (gen "    });")
  (for ([o (in-list (main-decl-options m))])
    (define p (main-option-parameter o))
    (define n (field-name p))
    (define type (option-value-type p))
    (define (at text) (emit! w text #:at (main-option-loc o)))
    (match (main-option-kind o)
      ['flag
       (at (format "    commandLine.flag(~a, ~a, [&inputs] { inputs.~a = true; });" (cpp-string (main-option-flag o))
                   (cpp-string (help-text o)) n))]
      [kind
       (if (eq? kind 'positional)
           (at (format "    commandLine.positional(~a, ~a, [&inputs](const std::string& text) {" (cpp-string (metavar o))
                       (cpp-string (help-text o))))
           (at (format "    commandLine.option(~a, ~a, ~a, [&inputs](const std::string& text) {" (cpp-string (main-option-flag o))
                       (cpp-string (metavar o)) (cpp-string (help-text o)))))
       (when (main-option-given o)
         (at (format "        inputs.~a = true;" (main-option-given o))))
       (match type
         ['path
          (at (format "        inputs.~a = zgal::commandLinePath(text);" n))
          (at "        return std::optional<std::string>();")]
         [_
          (define range (main-option-range o))
          (at (format "        return zgal::parseNumber<decltype(inputs.~a)>(text, inputs.~a~a);" n n
                      (if range
                          (format ", decltype(inputs.~a)(~a), decltype(inputs.~a)(~a)" n (value-cpp (car range) type) n (value-cpp (cdr range) type))
                          "")))])
       (at "    });")]))
  (gen "    const auto parsed = commandLine.parse(argc, argv);")
  (gen "    if (const int* status = std::get_if<int>(&parsed)) {")
  (gen "        return *status;")
  (gen "    }")
  (gen "    zgal::Launch launch = std::get<zgal::Launch>(parsed);")
  (when (and capture (third capture))
    (gen (format "    // The capture is written to ~a" (third capture)))
    (gen (format "    launch.capture = inputs.~a;" (third capture))))
  (gen "")
  (gen (format "    return zgal::~a<App>(" (if window "runWindowed" "runHeadless")))
  (gen "        commandLine, launch,")
  (gen "        [&inputs](VulkanContext& context, const zgal::Launch& launch,")
  (gen "                  const std::function<RenderGraph&()>& newGraph) -> Result<std::unique_ptr<App>> {")
  (gen "            (void)launch;")
  (match (main-decl-timestep m)
    [#f (void)]
    [(cons max-step fixed-step)
     (gen (format "            inputs.timestep = launch.timestep(~a, ~a);" (value-cpp max-step 'float) (value-cpp fixed-step 'float)))])
  (when (app-run-mode? a)
    (gen "            inputs.mode = launch.mode();"))
  (when (cpp-inputs? m)
    (gen (format "            TRY_ASSIGN(auto given, ~a::mainInputs(context));" ns))
    (for ([p (in-list (given-parameters m))])
      (gen (format "            inputs.~a = std::move(given.~a);" (field-name p) (field-name p))))
    (for ([g (in-list (app-given-members a))])
      (gen (format "            inputs.~a = std::move(given.~a);" (first g) (first g)))))
  (cond
    [(<= (length runs) 1)
     (gen "            return App::create(context, newGraph(), std::move(inputs));")]
    [else
     (gen "            App::Graphs graphs;")
     (for ([r (in-list runs)])
       (gen (format "            graphs.~a = &newGraph();" (lower-first (graph-name (graph-run-graph r))))))
     (gen "            return App::create(context, graphs, std::move(inputs));")])
  (gen "        },")
  (match capture
    [#f
     (gen "        [](App&) -> Result<zgal::Captured> {")
     (gen "            return Error(ErrorCode::Unsupported, \"The program captures nothing\");")
     (gen "        });")]
    [(list g-name node-name _)
     (define g (graph-run-graph (findf (λ (r) (equal? (graph-name (graph-run-graph r)) g-name)) runs)))
     (define node (findf (λ (n) (equal? (g-node-name n) node-name)) (graph-nodes g)))
     (define ids (if (<= (length runs) 1) "app.ids()" (format "app.~aIds()" (lower-first g-name))))
     (define id (if (g-node-when node)
                    (format "zgal::require(~a.nodes.~a, ~a, ~a)" ids node-name (cpp-string g-name) (cpp-string node-name))
                    (format "~a.nodes.~a" ids node-name)))
     (gen (format "        // The last frame of ~a's readback ~a" g-name node-name))
     (gen "        [](App& app) -> Result<zgal::Captured> {")
     (gen (format "            return zgal::captureReadback(app.renderGraph(), ~a);" id))
     (gen "        });")])
  (emit! w "}" #:at (main-decl-loc m))
  (writer-text w))
