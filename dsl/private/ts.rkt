#lang racket/base
;; The TypeScript backend (the web, with WebGPU): a module per .zgal file, name.zgal.ts, with its
;; structs (an interface and their layout), materials (descriptions of their bindings and push
;; constants, and their WGSL) and graphs, using the runtime in web/zgal (imported as ./zgal/, which
;; the build copies beside the module).

(require racket/list
         racket/match
         racket/string
         "ast.rkt"
         "errors.rkt"
         "layout.rkt"
         "ts-app.rkt"
         "ts-body.rkt"
         "ts-common.rkt"
         "ts-graph.rkt"
         "ts-main.rkt"
         "wgsl.rkt")

(provide emit-typescript
         typescript-file-name)

;; The module generated for a .zgal file: its file name plus .ts, e.g. scene.zgal.ts
(define (typescript-file-name source)
  (define-values (_dir file _must-be-dir) (split-path source))
  (string-append (path->string file) ".ts"))

(define (emit-typescript prog)
  (define out '())
  (define (line! fmt . args) (set! out (cons (apply format fmt args) out)))
  (line! "// Generated by zgal from ~a, for the web (WebGPU). Don't edit it: edit that file." (program-source prog))
  (line! "import * as zgal from './zgal/index.ts';")

  (for ([d (in-list (program-structs prog))])
    (line! "")
    (line! "export interface ~a {" (struct-decl-name d))
    (for ([f (in-list (struct-decl-fields d))])
      (line! "  ~a: ~a;" (field-name f) (ts-value-type (field-type f))))
    (line! "}")
    (line! "export const ~a: zgal.Type<~a> = zgal.struct<~a>(~a, [~a]);" (struct-decl-name d) (struct-decl-name d)
           (struct-decl-name d) (ts-string (struct-decl-name d))
           (string-join (for/list ([f (in-list (struct-decl-fields d))])
                          (format "[~a, ~a]" (ts-string (field-name f)) (ts-layout-type (field-type f))))
                        ", ")))

  ;; Vertex formats: how vertex buffers lay them out (for models, and meshes' encodeVertices)
  (for ([f (in-list (program-vertex-formats prog))])
    (define-values (stride placed) (vertex-layout f))
    (line! "")
    (line! "export const ~a: zgal.VertexFormatDesc = { name: ~a, stride: ~a, attributes: [" (vertex-format-name f)
           (ts-string (vertex-format-name f)) stride)
    (for ([entry (in-list placed)])
      (match-define (cons a offset) entry)
      (define t (field-type a))
      (define components (match t [(vector-t _ n) n] [_ 1]))
      (define m (model-attribute-of a))
      (define (number n) (if (exact-integer? n) (number->string n) (number->string (exact->inexact n))))
      (line! "  { name: ~a, offset: ~a, format: '~a', components: ~a, model: ~a, default: ~a },"
             (ts-string (field-name a)) offset (vertex-format-of a) components
             (if m
                 (format "{ member: '~a', size: ~a, fill: ~a }" (model-attribute-member m) (model-attribute-size m)
                         (exact->inexact (or (model-attribute-fill m) 0)))
                 "null")
             (match (attribute-default a)
               [#f "null"]
               [(list ns ...) (format "[~a]" (string-join (map number ns) ", "))]
               [n (format "[~a]" (string-join (for/list ([_ (in-range components)]) (number n)) ", "))])))
    (line! "] };"))

  ;; Functions and constants the CPU can use too
  (define cpu-declarations
    (filter (λ (d) (if (function-decl? d) (function-decl-cpu? d) (constant-decl-cpu? d))) (program-functions prog)))
  (unless (null? cpu-declarations)
    (line! "")
    (line! "// The file's functions and constants, compiled for the CPU too (those using no textures, images")
    (line! "// or stage variables)")
    (for ([d (in-list cpu-declarations)])
      (for ([l (in-list (if (function-decl? d) (ts-function d) (ts-constant d)))]) (line! "~a" l))))

  (for ([m (in-list (program-materials prog))])
    (for ([l (in-list (emit-material prog m))]) (line! "~a" l)))

  (for ([g (in-list (program-graphs prog))])
    (for ([l (in-list (emit-ts-graph prog g))]) (line! "~a" l)))

  (for ([a (in-list (program-apps prog))])
    (for ([l (in-list (emit-ts-app prog a))]) (line! "~a" l)))
  (when (program-main prog)
    (for ([l (in-list (emit-ts-main-inputs prog (program-main prog)))]) (line! "~a" l)))
  (string-append (string-join (reverse out) "\n") "\n"))

;; A TypeScript template literal of WGSL, with the storage images' formats from `formats`
(define (shader-template prog m s)
  (define marker "\u0001")
  (define text (emit-wgsl prog m s #:storage-format (λ (b) (string-append marker (binding-name b) marker))))
  (define escaped (regexp-replace* #rx"[`$\\\\]" text "\\\\&"))
  (string-append "`" (regexp-replace* #rx"\u0001([A-Za-z0-9_]+)\u0001" escaped "${formats['\\1']}") "`"))

;; WebGPU's vertex format of an attribute: 3-component 8- and 16-bit attributes, and 8- and 16-bit
;; scalars, are stored in 4 and 2 components (WebGPU has no others), whose extra ones shaders ignore
(define (vertex-format-of a)
  (define t (field-type a))
  (define n (match t [(vector-t _ n) n] [_ 1]))
  (define kind (match t [(vector-t k _) k] [(scalar-t k) k]))
  (match (attribute-storage a)
    [#f (define base (case kind [(float) "float32"] [(int) "sint32"] [(uint) "uint32"]))
        (if (= n 1) base (format "~ax~a" base n))]
    [s (define base (case s [(float16) "float16"] [(unorm8) "unorm8"] [(snorm8) "snorm8"] [(unorm16) "unorm16"]
                      [(snorm16) "snorm16"] [(uint8) "uint8"] [(uint16) "uint16"] [(int8) "sint8"] [(int16) "sint16"]))
       (format "~ax~a" base (case n [(1 2) 2] [(3 4) 4]))]))

(define (vertex-format-bytes a)
  (match (regexp-match #px"^[a-z]+([0-9]+)(?:x([0-9]))?$" (vertex-format-of a))
    [(list _ bits count) (* (quotient (string->number bits) 8) (if count (string->number count) 1))]))

;; A vertex format's layout in TypeScript vertex buffers: attributes one after another, each at a
;; multiple of 4 bytes: (values stride (list (cons attribute offset) ...))
(define (vertex-layout f)
  (for/fold ([acc '()] [offset 0] #:result (values (round-up offset 4) (reverse acc)))
            ([a (in-list (vertex-format-attributes f))])
    (define at (round-up offset 4))
    (values (cons (cons a at) acc) (+ at (vertex-format-bytes a)))))

(define (emit-material prog m)
  (define kind (material-kind m))
  (define bindings (wgsl-bindings prog m))
  (define push (wgsl-push-layout m))
  (define (stages-text b) (format "[~a]" (string-join (map (λ (s) (ts-string (symbol->string s))) (wgsl-binding-stages b)) ", ")))
  (append
   (list ""
         (format "export const ~a: zgal.~aMaterialDesc = {" (material-name m) (if (eq? kind 'compute) "Compute" "Graphics"))
         (format "  kind: '~a'," kind)
         (format "  name: ~a," (ts-string (material-name m)))
         "  bindings: [")
   (for/list ([b (in-list bindings)])
     (format "    { name: ~a, kind: '~a', access: ~a, stages: ~a, depth: ~a },"
             (ts-string (wgsl-binding-name b)) (wgsl-binding-kind b)
             (if (wgsl-binding-access b) (format "'~a'" (wgsl-binding-access b)) "null")
             (stages-text b) (if (wgsl-binding-depth? b) "true" "false")))
   (list "  ],")
   (if push
       (append
        (list (format "  push: { binding: ~a, size: ~a, fields: {" (wgsl-push-binding m) (cdr push)))
        (for/list ([entry (in-list (car push))])
          (format "    ~a: { offset: ~a, type: ~a }," (field-name (car entry)) (cdr entry) (ts-layout-type (field-type (car entry)))))
        (list "  } },"))
       (list "  push: null,"))
   (case kind
     [(compute)
      (match-define (list x y z) (material-workgroup m))
      (define fallback (hash-ref (program-fallbacks prog) (material-name m) #f))
      (when (and fallback (not (equal? (wgsl-bindings prog fallback) bindings)))
        (error 'emit-material "~a's variant without subgroups binds its resources differently" (material-name m)))
      (append
       (list (format "  workgroup: [~a, ~a, ~a]," x y z)
             (format "  compute: (formats) => ~a," (shader-template prog m (material-shader m 'compute))))
       (if fallback
           (list (format "  withoutSubgroups: (formats) => ~a," (shader-template prog fallback (material-shader fallback 'compute))))
           '()))]
     [(graphics)
      (define input (material-vertex-input m))
      (append
       (if input
           (let-values ([(stride placed) (vertex-layout (vertex-input-format input))])
             (list (format "  vertexInput: { stride: ~a, attributes: [~a] }," stride
                           (string-join
                            (for/list ([entry (in-list (vertex-input-attributes input))])
                              (match-define (cons location a) entry)
                              (define offset (cdr (assf (λ (x) (equal? (field-name x) (field-name a))) placed)))
                              (format "{ location: ~a, offset: ~a, format: '~a' }" location offset (vertex-format-of a)))
                            ", "))))
           (list "  vertexInput: null,"))
       (list (format "  colorOutputs: ~a," (length (material-outputs m)))
             (format "  vertex: (formats) => ~a," (shader-template prog m (material-shader m 'vertex)))
             (format "  fragment: (formats) => ~a," (shader-template prog m (material-shader m 'fragment)))))])
   (list "};")))
