#lang racket/base
;; The GLSL backend: one complete shader per material shader, for the wrapper's universal
;; ("bindless") descriptor set. A shader is the material's interface followed by the shader's body,
;; with #line directives mapping each line to the .zgal file or the body.

(require racket/list
         racket/match
         racket/string
         "ast.rkt"
         "body.rkt"
         "errors.rkt"
         "lower.rkt"
         "parse.rkt"
         "print-body.rkt"
         "writer.rkt")

(provide emit-shader
         check-body)

;; The declaration of a struct member or block member
(define (declaration t name)
  (match t
    [(array-t e n) (format "~a ~a[~a];" (type-name e) name n)]
    [_ (format "~a ~a;" (type-name t) name)]))

;; Buffer blocks are declared per type (and per kind: one holding a value, or an array of them)
(define (buffer-array-name b)
  (format "~a_~a" (if (eq? (binding-kind b) 'buffer) "zgalBuffers" "zgalBufferArrays")
          (type-name (binding-element b))))

(define (accessor b)
  (define index (format "materialPush.~a" (binding-name b)))
  (match (binding-kind b)
    ['texture (format "bindlessTextures[~a]" index)]
    ['sampler (format "bindlessSamplers[~a]" index)]
    ['storage-image (format "bindlessStorageImages[~a]" index)]
    [(or 'buffer 'buffer-array) (format "~a[~a].data" (buffer-array-name b) index)]))

(define (interpolation-qualifier v)
  (case (varying-interpolation v)
    [(flat) "flat "]
    [(noperspective) "noperspective "]
    [else ""]))

;; Reports what a body mustn't contain: the lines ZGAL writes itself
(define (check-body body path)
  (for ([line (in-list (string-split body "\n" #:trim? #f))] [number (in-naturals 1)])
    (when (regexp-match? #px"^\\s*#\\s*version\\b" line)
      (zgal-error 'version-in-body (loc path number 1)
                  "shader bodies don't declare #version: ZGAL writes it, with the material's interface, before the body"))))

;; The complete source of shader s of material m. body: a GLSL body's text (#f for a ZGAL body).
;; out-path: where the shader is written (for #line directives naming it).
(define (emit-shader prog m s body out-path)
  (when body (check-body body (shader-path s)))
  (define w (make-writer out-path))
  (emit! w "#version 450")
  (emit! w "#extension GL_GOOGLE_cpp_style_line_directive : require")
  (unless body
    (emit! w "#extension GL_EXT_samplerless_texture_functions : require"))
  (emit! w (format "// Generated by zgal from ~a: material ~a's interface, then ~a."
                   (program-source prog) (material-name m)
                   (if body (format "the body of ~a" (shader-path s)) (format "its ~a shader" (shader-stage s)))))
  (emit! w "// Don't edit it: edit those. #line directives map each line to one of them.")
  (emit! w "#include \"bindless.glsl\"")

  ;; Every struct in the file, so bodies can use them all
  (for ([d (in-list (program-structs prog))])
    (emit! w (format "struct ~a {" (struct-decl-name d)) #:at (struct-decl-loc d))
    (for ([f (in-list (struct-decl-fields d))])
      (emit! w (string-append "    " (declaration (field-type f) (field-name f))) #:at (field-loc f)))
    (emit! w "};" #:at (struct-decl-loc d)))

  ;; The push constants: binding indices, then push fields
  (define bindings (material-bindings m))
  (define push (material-push m))
  (unless (and (null? bindings) (null? push))
    (emit! w "layout(push_constant) uniform ZgalPush {" #:at (material-loc m))
    (for ([b (in-list bindings)])
      (emit! w (format "    uint ~a;" (binding-name b)) #:at (binding-loc b)))
    (for ([f (in-list push)])
      (emit! w (string-append "    " (declaration (field-type f) (field-name f))) #:at (field-loc f)))
    (emit! w "} materialPush;" #:at (material-loc m)))

  ;; Buffer blocks, one per type and kind. MoltenVK can't alias a readonly block with a writable
  ;; one at the same binding, so either every block is readonly or none is.
  (define qualifiers (if (material-writes-buffers? m) "" "readonly"))
  (for ([b (in-list (remove-duplicates
                     (filter (λ (b) (memq (binding-kind b) '(buffer buffer-array))) bindings)
                     #:key buffer-array-name))])
    (define t (type-name (binding-element b)))
    (emit! w (format "~a(~a, ZGAL~a_~a, ~a, ~a);"
                     (if (eq? (binding-kind b) 'buffer) "BINDLESS_BUFFER" "BINDLESS_BUFFER_ARRAY")
                     qualifiers
                     (if (eq? (binding-kind b) 'buffer) "Buffer" "BufferArray")
                     t t (buffer-array-name b))
           #:at (binding-loc b)))

  ;; Accessors: function-like macros, so they don't replace the push constant members' names
  (for ([b (in-list bindings)])
    (emit! w (format "#define ~a() (~a)" (binding-name b) (accessor b)) #:at (binding-loc b)))
  (for ([f (in-list push)])
    (emit! w (format "#define ~a() (materialPush.~a)" (field-name f) (field-name f)) #:at (field-loc f)))

  ;; The stage's inputs and outputs
  (match (shader-stage s)
    ['vertex
     (define input (material-vertex-input m))
     (when input
       (for ([entry (in-list (vertex-input-attributes input))])
         (match-define (cons index a) entry)
         (emit! w (format "layout(location = ~a) in ~a" index
                          (declaration (field-type a) (input-variable-name (field-name a))))
                #:at (field-loc a))))
     (for ([v (in-list (material-varyings m))] [location (in-naturals)])
       (emit! w (format "layout(location = ~a) ~aout ~a" location (interpolation-qualifier v)
                        (declaration (varying-type v) (varying-name v)))
              #:at (varying-loc v)))]
    ['fragment
     (for ([v (in-list (material-varyings m))] [location (in-naturals)])
       (emit! w (format "layout(location = ~a) ~ain ~a" location (interpolation-qualifier v)
                        (declaration (varying-type v) (varying-name v)))
              #:at (varying-loc v)))
     (for ([o (in-list (material-outputs m))] [location (in-naturals)])
       (emit! w (format "layout(location = ~a) out ~a" location (declaration (field-type o) (field-name o)))
              #:at (field-loc o)))]
    ['compute
     (match-define (list x y z) (material-workgroup m))
     (emit! w (format "layout(local_size_x = ~a, local_size_y = ~a, local_size_z = ~a) in;" x y z)
            #:at (material-loc m))])

  (cond
    [body
     ;; The body, numbered as itself
     (define body-lines (string-split (string-trim body "\n" #:left? #f #:repeat? #t) "\n" #:trim? #f))
     (for ([line (in-list body-lines)] [number (in-naturals 1)])
       (emit! w line #:at (loc (shader-path s) number 1)))]
    [else
     ;; The file's functions and constants the body uses, then the body as main()
     (define declarations
       (for/hash ([d (in-list (program-functions prog))])
         (values (if (function-decl? d) (function-decl-name d) (constant-decl-name d)) d)))
     (for ([name (in-list (zgal-shader-uses s))])
       (define d (hash-ref declarations name))
       (if (function-decl? d) (emit-function! w d 'glsl) (emit-constant! w d 'glsl)))
     (emit-main! w s)])
  (writer-text w))

(define (emit-main! w s)
  (define n 0)
  (define (fresh base)
    (set! n (add1 n))
    (format "zgal~a~a" (string-titlecase base) n))
  (define-values (stmts results) (lower (zgal-shader-body s) fresh))
  (emit! w "void main() {" #:at (shader-loc s))
  (emit-statements! w stmts 'glsl "    ")
  (when (list? results)
    (for ([r (in-list results)])
      (match-define (cons name e) r)
      (emit! w (format "    ~a = ~a;" (if (and (eq? (shader-stage s) 'vertex) (string=? name "position")) "gl_Position" name)
                       (print-expression e 'glsl))
             #:at (texpr-loc e))))
  (emit! w "}" #:at (shader-loc s)))
