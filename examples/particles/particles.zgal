;; The particles example's shaders and graph, in ZGAL (dsl/; `make docs` for the language). The
;; build generates particles.zgal.h and the complete shaders.

;; The simulation's parameters for one frame, written by the CPU
(struct SimParams
  (attractor vec2)
  (dt float)
  (time float)
  (aspect float)                ; Simulation space is [-aspect, aspect] x [-1, 1], y down like NDC
  (attractorStrength float)
  (stepIndex uint)              ; Simulation steps so far: seeds respawns
  (reset uint)                  ; Non-zero: respawn every particle
  (particleCount uint)
  (particleRadius float))

(struct Particle
  (position vec2)
  (velocity vec2)
  (life float)                  ; Seconds left; respawned at 0
  (maxLife float))

;; PCG hash: a well distributed random uint from a uint
(define (pcgHash [v : uint]) : uint
  (let* ([state (+ (* v 747796405) 2891336453)]
         [word (* (bitxor (shr state (+ (shr state 28) 4)) state) 277803737)])
    (bitxor (shr word 22) word)))

;; A random float in [0, 1] from a random uint
(define (unitFloat [random : uint]) : float
  (/ (float random) 4294967295.0))

;; A new particle on a ring around the centre, drifting round it. Each random number hashes the
;; previous one.
(define (spawn [index : uint] [params : SimParams]) : Particle
  (let* ([seed (pcgHash (bitxor index (pcgHash params.stepIndex)))]
         [r1 (pcgHash seed)]
         [r2 (pcgHash r1)]
         [r3 (pcgHash r2)]
         [r4 (pcgHash r3)]
         [r5 (pcgHash r4)]
         [angle (* (unitFloat r1) 6.2831853)]
         [radius (+ 0.3 (* 0.6 (unitFloat r2)))]
         [direction (vec2 (cos angle) (sin angle))]
         [maxLife (+ 3.0 (* 5.0 (unitFloat r4)))])
    (Particle (* direction radius (vec2 params.aspect 1.0))
              (* (vec2 (- direction.y) direction.x) (+ 0.2 (* 0.3 (unitFloat r3))))
              ;; Spread initial lifetimes so particles don't all respawn together
              (if (not= params.reset 0) (* maxLife (unitFloat r5)) maxLife)
              maxLife)))

;; Integrates the particles, one invocation each
(compute-material ParticleSim
  (workgroup 256)
  (bindings
   (params (buffer SimParams))
   (particles (buffer-array Particle)))
  (compute
   (let* ([index globalInvocationId.x])
     (when (< index params.particleCount)
       (if (not= params.reset 0)
           (write! (at particles index) (spawn index params))
           (let* ([p (at particles index)]
                  ;; Softened inverse-square attraction, so particles passing through the attractor
                  ;; don't explode
                  [toAttractor (- params.attractor p.position)]
                  [distanceSquared (+ (dot toAttractor toAttractor) 0.01)]
                  [acceleration (/ (* params.attractorStrength toAttractor (inversesqrt distanceSquared)) distanceSquared)]
                  ;; Damped independently of the timestep
                  [velocity (* (+ p.velocity (* acceleration params.dt)) (exp (* -0.6 params.dt)))]
                  [position (+ p.position (* velocity params.dt))]
                  [life (- p.life params.dt)]
                  ;; Respawn particles that expired or left the screen
                  [offscreen (any (greaterThan (abs position) (* (vec2 params.aspect 1.0) 1.5)))])
             (write! (at particles index)
                     (if (or (<= life 0.0) offscreen)
                         (spawn index params)
                         (with p #:position position #:velocity velocity #:life life)))))))))

;; The corners of a particle's quad, as two triangles
(define corners
  (array vec2 (vec2 -1 -1) (vec2 1 -1) (vec2 1 1) (vec2 1 1) (vec2 -1 1) (vec2 -1 -1)))

;; Draws every particle as a soft quad: two triangles per particle, pulled from the particle buffer
;; by the vertex index rather than read as vertex attributes (vertex 6 * i + c is corner c of
;; particle i's quad). That's the bindless way: the buffer is already in the universal descriptor
;; set for the simulation, it needs no vertex input state, and the graph sees the read through the
;; binding like any other.
(graphics-material ParticleDraw
  (bindings
   (params (buffer SimParams))
   (particles (buffer-array Particle)))
  (varyings
   (corner vec2)                ; [-1, 1] across the quad
   (color vec3))
  (outputs
   (outColor vec4))
  (vertex
   (let* ([p (at particles (/ vertexIndex 6))]
          [quadCorner (at corners (remainder vertexIndex 6))]
          [position (+ p.position (* quadCorner params.particleRadius))]
          ;; Slow particles are deep blue, fast ones orange; all fade in and out over their lives
          [speed (length p.velocity)]
          [tint (mix (vec3 0.05 0.15 0.6) (vec3 1.0 0.45 0.1) (clamp (* speed 0.6) 0.0 1.0))]
          [age (- 1.0 (/ p.life p.maxLife))]
          [fade (* (smoothstep 0.0 0.1 age) (smoothstep 0.0 0.3 (/ p.life p.maxLife)))])
     (results #:position (vec4 (/ position.x params.aspect) position.y 0.0 1.0)
              #:corner quadCorner
              #:color (* tint fade))))
  ;; A soft round sprite. Blending is additive, so dense regions glow.
  (fragment
   (vec4 (* color (exp (* -4.0 (dot corner corner))) 0.35) 1.0)))

;; The frame: the simulation, then the draw. The simulation writes the particle buffer and the draw
;; reads it, so the graph runs them in that order (on different queues if it can) and synchronizes
;; them.
(graph ParticlesGraph
  ;; Headless, the particles are drawn into an image of this size instead of the window, and with
  ;; capture the last frame is read back
  (parameter headless bool)
  (parameter capture bool)
  (parameter width uint)
  (parameter height uint)
  (parameter particleCount uint)
  (input params (per-frame SimParams))
  (input report cpu)

  ;; A parameter buffer per frame in flight, so the CPU can write the next frame's while the GPU
  ;; reads the previous one's
  (uniform simParams SimParams params)
  ;; The particles live on the GPU only, in one buffer shared by every frame: each frame's
  ;; simulation continues from the last, and waits for the previous frame's draw
  (buffer particles Particle particleCount #:frames shared)
  (image offscreen rgba8-srgb (fixed width height) #:frames per-frame #:when headless)
  ;; No depth: additive blending doesn't need it
  (target screen (if headless
                     (color offscreen #:clear (0.0 0.0 0.01 1.0))
                     (surface #:clear (0.0 0.0 0.01 1.0) #:depth none)))

  (material simulation ParticleSim (params simParams) particles
            #:invocations (particleCount))
  ;; Overlapping particles add up, so the result doesn't depend on draw order
  (material drawing ParticleDraw (params simParams) particles
            #:cull none #:blend additive)

  (dispatch simulate simulation)
  (draw drawParticles screen drawing (* 6 particleCount))
  ;; Reports the frame rate. CPU nodes run each frame in graph order.
  (cpu report report)
  (readback readback offscreen #:when capture))
