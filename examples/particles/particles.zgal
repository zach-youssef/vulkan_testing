;; GPU particles: a compute pass integrates particles attracted to the mouse, and a graphics pass
;; draws them with additive blending. The render graph orders the two, puts the compute pass on
;; another queue when it can and synchronizes them; there are no barriers or semaphores anywhere.
;; The shaders, the graph, the app and its main are all here, in ZGAL (dsl/; `make docs` for the
;; language): the build generates particles.zgal.h, its main (particles.zgal.main.cpp) and the
;; complete shaders, and the example has no C++ of its own.
;;
;;     particles                                   interactive, in a window
;;     particles --frames N [--capture out.png]    N frames headless (the smoke test)

;; From the standard library: pcgHash and unitFloat
(import random)

;; The simulation's parameters for one frame, written by the CPU
(struct SimParams
  (attractor vec2)
  (dt float)
  (time float)
  (aspect float)                ; Simulation space is [-aspect, aspect] x [-1, 1], y down like NDC
  (attractorStrength float)
  (stepIndex uint)              ; Simulation steps so far: seeds respawns
  (reset uint)                  ; Non-zero: respawn every particle
  (particleCount uint)
  (particleRadius float))

(struct Particle
  (position vec2)
  (velocity vec2)
  (life float)                  ; Seconds left; respawned at 0
  (maxLife float))

;; A new particle on a ring around the centre, drifting round it. Each random number hashes the
;; previous one.
(define (spawn [index : uint] [params : SimParams]) : Particle
  (let* ([seed (pcgHash (bitxor index (pcgHash params.stepIndex)))]
         [r1 (pcgHash seed)]
         [r2 (pcgHash r1)]
         [r3 (pcgHash r2)]
         [r4 (pcgHash r3)]
         [r5 (pcgHash r4)]
         [angle (* (unitFloat r1) 6.2831853)]
         [radius (+ 0.3 (* 0.6 (unitFloat r2)))]
         [direction (vec2 (cos angle) (sin angle))]
         [maxLife (+ 3.0 (* 5.0 (unitFloat r4)))])
    (Particle (* direction radius (vec2 params.aspect 1.0))
              (* (vec2 (- direction.y) direction.x) (+ 0.2 (* 0.3 (unitFloat r3))))
              ;; Spread initial lifetimes so particles don't all respawn together
              (if (not= params.reset 0) (* maxLife (unitFloat r5)) maxLife)
              maxLife)))

;; Integrates the particles, one invocation each
(compute-material ParticleSim
  (workgroup 256)
  (bindings
   (params (buffer SimParams))
   (particles (buffer-array Particle)))
  (compute
   (let* ([index globalInvocationId.x])
     (when (< index params.particleCount)
       (if (not= params.reset 0)
           (write! (at particles index) (spawn index params))
           (let* ([p (at particles index)]
                  ;; Softened inverse-square attraction, so particles passing through the attractor
                  ;; don't explode
                  [toAttractor (- params.attractor p.position)]
                  [distanceSquared (+ (dot toAttractor toAttractor) 0.01)]
                  [acceleration (/ (* params.attractorStrength toAttractor (inversesqrt distanceSquared)) distanceSquared)]
                  ;; Damped independently of the timestep
                  [velocity (* (+ p.velocity (* acceleration params.dt)) (exp (* -0.6 params.dt)))]
                  [position (+ p.position (* velocity params.dt))]
                  [life (- p.life params.dt)]
                  ;; Respawn particles that expired or left the screen
                  [offscreen (any (greaterThan (abs position) (* (vec2 params.aspect 1.0) 1.5)))])
             (write! (at particles index)
                     (if (or (<= life 0.0) offscreen)
                         (spawn index params)
                         (with p #:position position #:velocity velocity #:life life)))))))))

;; The corners of a particle's quad, as two triangles
(define corners
  (array vec2 (vec2 -1 -1) (vec2 1 -1) (vec2 1 1) (vec2 1 1) (vec2 -1 1) (vec2 -1 -1)))

;; Draws every particle as a soft quad: two triangles per particle, pulled from the particle buffer
;; by the vertex index rather than read as vertex attributes (vertex 6 * i + c is corner c of
;; particle i's quad). That's the bindless way: the buffer is already in the universal descriptor
;; set for the simulation, it needs no vertex input state, and the graph sees the read through the
;; binding like any other.
(graphics-material ParticleDraw
  (bindings
   (params (buffer SimParams))
   (particles (buffer-array Particle)))
  (varyings
   (corner vec2)                ; [-1, 1] across the quad
   (color vec3))
  (outputs
   (outColor vec4))
  (vertex
   (let* ([p (at particles (/ vertexIndex 6))]
          [quadCorner (at corners (remainder vertexIndex 6))]
          [position (+ p.position (* quadCorner params.particleRadius))]
          ;; Slow particles are deep blue, fast ones orange; all fade in and out over their lives
          [speed (length p.velocity)]
          [tint (mix (vec3 0.05 0.15 0.6) (vec3 1.0 0.45 0.1) (clamp (* speed 0.6) 0.0 1.0))]
          [age (- 1.0 (/ p.life p.maxLife))]
          [fade (* (smoothstep 0.0 0.1 age) (smoothstep 0.0 0.3 (/ p.life p.maxLife)))])
     (results #:position (vec4 (/ position.x params.aspect) position.y 0.0 1.0)
              #:corner quadCorner
              #:color (* tint fade))))
  ;; A soft round sprite. Blending is additive, so dense regions glow.
  (fragment
   (vec4 (* color (exp (* -4.0 (dot corner corner))) 0.35) 1.0)))

;; The frame: the simulation, then the draw. The simulation writes the particle buffer and the draw
;; reads it, so the graph runs them in that order (on different queues if it can) and synchronizes
;; them.
(graph ParticlesGraph
  ;; Headless, the particles are drawn into an image the size of the surface instead of the window,
  ;; and with capture the last frame is read back
  (parameter headless bool)
  (parameter capture bool)
  (parameter particleCount uint)
  (input params (per-frame SimParams))

  ;; A parameter buffer per frame in flight, so the CPU can write the next frame's while the GPU
  ;; reads the previous one's
  (uniform simParams SimParams params)
  ;; The particles live on the GPU only, in one buffer shared by every frame: each frame's
  ;; simulation continues from the last, and waits for the previous frame's draw
  (buffer particles Particle particleCount #:frames shared)
  (image offscreen rgba8-srgb (surface 1.0) #:frames per-frame #:when headless)
  ;; No depth: additive blending doesn't need it
  (target screen (if headless
                     (color offscreen #:clear (0.0 0.0 0.01 1.0))
                     (surface #:clear (0.0 0.0 0.01 1.0) #:depth none)))

  (material simulation ParticleSim (params simParams) particles
            #:invocations (particleCount))
  ;; Overlapping particles add up, so the result doesn't depend on draw order
  (material drawing ParticleDraw (params simParams) particles
            #:cull none #:blend additive)

  (dispatch simulate simulation)
  (draw drawParticles screen drawing (* 6 particleCount))
  (readback readback offscreen #:when capture))

;; The app: the controls and the simulation's clock, as state the handlers compute the next of, and
;; the parameters each frame's simulation gets from it
(app ParticlesApp
  (parameter particleCount uint)
  (state
   (paused bool #f)
   (resetRequested bool #t)     ; The particle buffer starts out uninitialized
   (resetting bool #f)          ; This frame respawns every particle
   (mouseHeld bool #f)
   (mouse vec2 (vec2 0.0))      ; In simulation space, while the left button is held
   (dt float 0.0)
   (time float 0.0)
   (steps uint 0)               ; Frames begun
   (reportTime float 0.0)       ; Since the frame rate was last printed
   (reportFrames uint 0))

  ;; Takes effect at the next frame boundary; per-frame resources follow
  (on (key-pressed 1) (set-frames-in-flight! 1) (print! "Frames in flight: 1"))
  (on (key-pressed 2) (set-frames-in-flight! 2) (print! "Frames in flight: 2"))
  (on (key-pressed 3) (set-frames-in-flight! 3) (print! "Frames in flight: 3"))
  (on (key-pressed space)
    (if state.paused (print! "Running") (print! "Paused"))
    (with state #:paused (not state.paused)))
  (on (key-pressed r) (with state #:resetRequested #t))
  ;; The cursor is in [-1, 1] across the window: simulation space is as wide as the aspect
  (on (mouse-pressed left cursor)
    (with state #:mouseHeld #t
                #:mouse (* cursor (vec2 (/ surfaceSize.x surfaceSize.y) 1.0))))
  (on (mouse-released left cursor) (with state #:mouseHeld #f))
  (on (cursor-moved cursor)
    (if state.mouseHeld
        (with state #:mouse (* cursor (vec2 (/ surfaceSize.x surfaceSize.y) 1.0)))
        state))
  ;; The clock stands still while paused, and for the first frame. Prints the frame rate every
  ;; couple of seconds. A smoke test (--frames N) changes the frames in flight twice, to exercise
  ;; resizing per-frame resources.
  (on (frame elapsed)
    (let* ([dt (if (or state.paused (= state.steps 0)) 0.0 elapsed)]
           [reportTime (+ state.reportTime elapsed)]
           [report (>= reportTime 2.0)])
      (when (and (> frameLimit 0) (= frameNumber (/ frameLimit 3)))
        (set-frames-in-flight! 3))
      (when (and (> frameLimit 0) (= frameNumber (/ (* 2 frameLimit) 3)))
        (set-frames-in-flight! 1))
      (when report
        (print! (/ (float (+ state.reportFrames 1)) reportTime) " fps, " framesInFlight " frames in flight"))
      (with state #:dt dt #:time (+ state.time dt) #:steps (+ state.steps 1)
                  #:resetting state.resetRequested #:resetRequested #f
                  #:reportTime (if report 0.0 reportTime)
                  #:reportFrames (if report 0 (+ state.reportFrames 1)))))

  (run ParticlesGraph
    (headless headless)
    (capture capture)
    (particleCount particleCount)
    ;; Without the mouse, the attractor wanders on a Lissajous curve
    (params (let* ([aspect (/ surfaceSize.x surfaceSize.y)])
              (SimParams (if state.mouseHeld
                             state.mouse
                             (vec2 (* 0.6 aspect (sin (* 0.4 state.time))) (* 0.5 (sin (* 0.7 state.time)))))
                         state.dt
                         state.time
                         aspect
                         0.15
                         (- state.steps 1)
                         (if state.resetting 1 0)
                         particleCount
                         0.006)))))

;; The program: a window (headless with --frames), the clock (real time interactively, a fixed step
;; for a smoke test, so it's deterministic), and the last frame's capture
(main ParticlesApp
  (about "GPU particles attracted to the mouse")
  (window "Particles" 1280 800)
  (timestep #:max 1/30 #:fixed 1/60)
  (capture readback)
  (option particleCount "--particles" "how many particles" #:default 100000 #:range (1 4000000))
  (controls "Controls:"
            "  left mouse  attract particles to the cursor"
            "  space       pause / resume"
            "  R           reset the particles"
            "  1, 2, 3     frames in flight"))
