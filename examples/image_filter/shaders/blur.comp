#version 450
#include "filter_common.glsl"

// One direction of a separable Gaussian blur, in linear light (so bright and dark areas mix as
// light does)
layout(push_constant) uniform Params {
    uint source;
    uint destination;
    int directionX;   // (1, 0) for the horizontal pass, (0, 1) for the vertical one
    int directionY;
    int radius;       // In pixels; the kernel covers [-radius, radius]
    float sigma;
} params;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (outside(texel, imageSize(bindlessStorageImages[params.destination]))) {
        return;
    }
    ivec2 direction = ivec2(params.directionX, params.directionY);
    vec4 sum = vec4(0.0);
    float totalWeight = 0.0;
    for (int i = -params.radius; i <= params.radius; ++i) {
        float weight = exp(-float(i * i) / (2.0 * params.sigma * params.sigma));
        sum += weight * loadClamped(params.source, texel + i * direction);
        totalWeight += weight;
    }
    imageStore(bindlessStorageImages[params.destination], texel, sum / totalWeight);
}
