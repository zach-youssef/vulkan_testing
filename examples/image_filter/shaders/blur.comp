#include "filter_common.glsl"

// One direction of a separable Gaussian blur, in linear light (so bright and dark areas mix as
// light does)
void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (outside(texel, imageSize(destination()))) {
        return;
    }
    vec4 sum = vec4(0.0);
    float totalWeight = 0.0;
    for (int i = -radius(); i <= radius(); ++i) {
        float weight = exp(-float(i * i) / (2.0 * sigma() * sigma()));
        sum += weight * loadClamped(source(), texel + i * direction());
        totalWeight += weight;
    }
    imageStore(destination(), texel, sum / totalWeight);
}
