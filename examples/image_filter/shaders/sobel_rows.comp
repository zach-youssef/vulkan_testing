#version 450
#include "filter_common.glsl"

// The horizontal half of a separable Sobel operator on perceived brightness. The 3x3 kernels
// factor into a [1 2 1] smoothing and a [-1 0 1] difference:
//     Gx = [1 2 1]^T * [-1 0 1]      Gy = [-1 0 1]^T * [1 2 1]
// This pass applies the horizontal factors, storing the difference (for Gx) in red and the
// smoothing (for Gy) in green. sobel_columns.comp applies the vertical ones.
layout(push_constant) uniform Indices {
    uint source;
    uint destination;
} indices;

float brightness(ivec2 texel) {
    return perceivedBrightness(loadClamped(indices.source, texel).rgb);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (outside(texel, imageSize(bindlessStorageImages[indices.destination]))) {
        return;
    }
    float left = brightness(texel - ivec2(1, 0));
    float centre = brightness(texel);
    float right = brightness(texel + ivec2(1, 0));
    imageStore(bindlessStorageImages[indices.destination], texel,
               vec4(right - left, left + 2.0 * centre + right, 0.0, 1.0));
}
