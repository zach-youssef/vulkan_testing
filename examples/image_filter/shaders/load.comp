#include "filter_common.glsl"

// Copies the input into the working image. The input is an sRGB texture, so sampling decodes it
// to linear colour.
void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (outside(texel, imageSize(working()))) {
        return;
    }
    vec4 colour = texelFetch(sampler2D(source(), sourceSampler()), texel, 0);
    imageStore(working(), texel, colour);
}
