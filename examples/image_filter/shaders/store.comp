#include "filter_common.glsl"

// Encodes the linear working image as sRGB bytes for the PNG. Storage images can't be sRGB, so the
// output is UNORM and the encoding happens here.
void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (outside(texel, imageSize(encoded()))) {
        return;
    }
    vec4 colour = imageLoad(working(), texel);
    imageStore(encoded(), texel, vec4(srgbEncode(colour.rgb), clamp(colour.a, 0.0, 1.0)));
}
