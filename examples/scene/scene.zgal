;; The scene example's shader interfaces, in ZGAL (dsl/; `make docs` for the language). The build
;; generates scene.zgal.h, with the structs and a class per material, and the complete shaders:
;; each body in shaders/ preceded by its material's interface.

;; Per-frame data shared by the shadow and lit passes, written by LitMaterial::update
(struct SceneUniforms
  (viewProjection mat4)         ; Camera
  (lightViewProjection mat4)    ; World to shadow map clip space
  (cameraPosition vec3)
  (lightDirection vec3)         ; Unit vector towards the light
  (lightRadiance vec3)          ; Linear colour times intensity
  (skyAmbient vec3)             ; Ambient light from above
  (groundAmbient vec3))         ; Ambient light from below

;; The scene's vertices: world space (nothing moves), each carrying its surface's material
(vertex-format SceneVertex
  (position vec3)
  (normal vec3)
  (albedoRoughness vec4))       ; rgb: linear albedo, a: roughness

;; The scene's depth from the light, into the shadow map. It reads the same vertex buffers as the
;; lit pass, skipping all but the positions.
(graphics-material Shadow
  (shaders "shaders/shadow.vert" "shaders/shadow.frag")
  (vertex-input SceneVertex position)
  (bindings
   (scene (buffer SceneUniforms read) #:stages (vertex)))
  (outputs))                    ; Depth only

;; PBR shading with filtered shadows, into the HDR image
(graphics-material Lit
  (shaders "shaders/lit.vert" "shaders/lit.frag")
  (vertex-input SceneVertex)
  (bindings
   (scene (buffer SceneUniforms read))
   (shadowMap texture #:stages (fragment))   ; The shadow pass's depth image
   (shadowSampler sampler))                  ; A comparison sampler: returns the fraction lit
  (push
   (shadowsEnabled uint))       ; 0 while the shadow pass is disabled, as its map is stale
  (varyings
   (worldPosition vec3)
   (worldNormal vec3)
   (albedoRoughness vec4))
  (outputs
   (outColor vec4)))            ; Linear HDR radiance

;; Exposure and an ACES curve, from the HDR image to the display. A fullscreen triangle without
;; vertex input.
(graphics-material Tonemap
  (shaders "shaders/tonemap.vert" "shaders/tonemap.frag")
  (bindings
   (hdr texture #:stages (fragment))
   (hdrSampler sampler))
  (push
   (exposure float))
  (varyings
   (uv vec2))
  (outputs
   (outColor vec4)))            ; Linear: the sRGB target encodes it

;; The frame: a shadow map from the light, the lit scene into an HDR image the size of the surface,
;; then the tonemap to the display. The render graph orders the passes, picks queues and
;; synchronizes them from what each uses.
(graph SceneGraph
  ;; Headless, the display is an image instead of the window, and with capture it's read back
  (parameter headless bool)
  (parameter capture bool)
  (input meshes meshes)                        ; Drawn by both the shadow and the lit pass
  (input uniforms (per-frame SceneUniforms))
  (input shadows (per-frame bool))             ; Whether the shadow pass is enabled
  (input exposure (per-frame float))

  ;; Bilinear for the HDR image, and a comparison sampler for the shadow map, which returns how
  ;; much of the bilinear footprint is closer to the light than the reference depth. Outside the
  ;; map the white border reads as lit.
  (sampler linearSampler #:filter linear #:address clamp-to-edge)
  (sampler shadowSampler #:filter linear #:mipmap nearest #:address clamp-to-border #:border opaque-white
           #:compare less-or-equal #:anisotropy #f)
  (uniform scene SceneUniforms uniforms)

  ;; Shared between frames to save memory: the next frame's shadow pass waits for this frame's lit
  ;; pass to finish reading it
  (image shadowMap d32 (fixed 2048 2048) #:frames shared)
  ;; Per frame, so a frame's lit pass can overlap the previous frame's tonemap. It follows the
  ;; surface's size (headless, the extent given to the graph).
  (image hdr rgba16f (surface 1.0) #:frames per-frame)
  (image depth d32 (surface 1.0) #:frames shared)
  (image offscreen rgba8-srgb (surface 1.0) #:frames shared #:when headless)

  (target shadowTarget (depth shadowMap #:store store))
  ;; The clear colour is the sky, in linear HDR like everything drawn
  (target hdrTarget (color hdr #:clear (0.4 0.55 0.8 1.0)) (depth depth))
  (target display (if headless (color offscreen) (surface #:depth none)))

  (material shadow Shadow scene)
  (material lit Lit scene shadowMap shadowSampler
            ;; When the shadow pass is disabled, its map is stale
            #:push ((shadowsEnabled (if shadows 1 0))))
  (material tonemap Tonemap hdr (hdrSampler linearSampler)
            #:push ((exposure exposure)))

  (draw-meshes shadowPass shadowTarget meshes shadow)
  (draw-meshes litPass hdrTarget meshes lit)
  ;; A fullscreen triangle, without vertex buffers
  (draw tonemapPass display tonemap 3)
  (readback readback offscreen #:when capture))
